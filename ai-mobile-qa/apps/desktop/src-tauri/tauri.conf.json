{
	"build": {
		"beforeBuildCommand": "npm run build",
		"beforeDevCommand": "npm run dev",
		"devPath": "http://localhost:5173",
		"distDir": "../dist"
	},
	"package": {
		"productName": "Tezzy",
		"version": "0.0.0"
	},
	"tauri": {
		"allowlist": {
			"all": true,
			"protocol": {
				"asset": true,
				"assetScope": ["**"]
			}
		},
		"bundle": {
			"active": true,
			"identifier": "com.tezzy.app",
			"icon": [
				"icons/Tezzy-Logo.ico"
			]
		},
		"windows": [
			{
				"title": "Tezzy",
				"width": 1200,
				"height": 800,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	}
}
