# Copy to .env (do NOT commit .env)
#
# Required: OpenAI API key for the ai-engine.
# Example:
# OPENAI_API_KEY=sk-...
OPENAI_API_KEY=

# Optional: use OpenRouter instead of OpenAI direct
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_APP_NAME=Tezzy Local Dev

# Optional: model override
# TEZZY_LLM_MODEL=gpt-4.1-mini
# TEZZY_VISION_MODEL=gpt-4o

# Optional: allow CORS for local dev UI clients
# TEZZY_DEV_CORS=1
# TEZZY_CORS_ORIGINS=http://localhost:5173,tauri://localhost
