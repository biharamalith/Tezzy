# Copy to .env (do NOT commit .env)
#
# Required: OpenAI API key for the ai-engine.
# Example:
# OPENAI_API_KEY=sk-...
OPENAI_API_KEY=

# Optional: model override
# TEZZY_LLM_MODEL=gpt-4.1-mini

# Optional: allow CORS for local dev UI clients
# TEZZY_DEV_CORS=1
# TEZZY_CORS_ORIGINS=http://localhost:5173,tauri://localhost
